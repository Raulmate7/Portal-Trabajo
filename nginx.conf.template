# =====================================================================
# Plantilla de Configuración de Nginx para Portal Trabajo IT (con HTTPS)
# Ruta sugerida en servidor: /etc/nginx/sites-available/portalempleoit
# =====================================================================

# Configuración de compresión Gzip para mejorar la velocidad (SEO)
gzip on;
gzip_proxied any;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
gzip_vary on;
gzip_comp_level 6;
gzip_buffers 16 8k;
gzip_min_length 256;

# =====================================================================
# Configuración Real IP para Cloudflare y Proxies Inversos (Vector 17)
# Solo se confía en la cabecera CF-Connecting-IP si proviene de rangos oficiales
# =====================================================================
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
set_real_ip_from 127.0.0.1;
set_real_ip_from ::1;

real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# Zonas de Rate Limiting (Evaluadas sobre la IP real validada)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=global_limit:20m rate=30r/s;


# Redirección de HTTP (puerto 80) a HTTPS (puerto 443)
server {
    listen 80;
    listen [::]:80;
    server_name portalempleoit.com www.portalempleoit.com;
    return 301 https://$host$request_uri;
}

# Servidor principal (HTTPS - Puerto 443)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name portalempleoit.com www.portalempleoit.com;

    # Certificados SSL (Generados por ejemplo con Let's Encrypt / Certbot)
    # Para generar: sudo certbot --nginx -d portalempleoit.com -d www.portalempleoit.com
    ssl_certificate /etc/letsencrypt/live/portalempleoit.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portalempleoit.com/privkey.pem;

    # Deshabilitar emisión de versión de Nginx para evitar fingerprinting de servidor (Vector 32)
    server_tokens off;

    # Opciones de seguridad SSL recomendadas (Modernas)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Cabeceras HSTS (HTTP Strict Transport Security) y de Seguridad (Vector 31)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;

    # Tamaño máximo de subida (por si se suben CVs grandes en el futuro)
    client_max_body_size 10M;

    # =====================================================================
    # Bloqueo exhaustivo de archivos sensibles, dotfiles y backups (Vector 33)
    # =====================================================================
    # Bloquear explícitamente acceso a db_proxy.php, archivos PHP y ficheros sensibles
    location ~* /(db_proxy\.php|\.env|\.git|\.ht) {
        deny all;
        return 404;
    }

    # Bloquear dotfiles y dotfolders (e.g. /.git, /.env, /.github), preservando /.well-known/
    location ~ /\.(?!well-known) {
        deny all;
        return 404;
    }

    # Bloquear extensiones de backup, scripts de servidor, bases de datos y configuraciones
    location ~* \.(sql|bak|backup|config|conf|ini|log|sh|py|yml|yaml|tar|gz|zip|swp|dist)$ {
        deny all;
        return 404;
    }

    # Bloquear ejecución o acceso directo a ficheros PHP
    location ~ \.php$ {
        deny all;
        return 404;
    }

    # Configuración de proxy inverso para API con rate-limiting estricto (10 req/s, burst 10)
    location /api/ {
        limit_req zone=api_limit burst=10 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Eliminar cabeceras informativas del backend (Vector 32)
        proxy_hide_header X-Powered-By;
        
        # Cabeceras de IP real validadas para logs y rate limiters en Next.js (Vector 17)
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Configuración del proxy inverso para Next.js (Páginas y navegación general)
    location / {
        limit_req zone=global_limit burst=20 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Eliminar cabeceras informativas del backend (Vector 32)
        proxy_hide_header X-Powered-By;
        
        # Cabeceras de IP real validadas para logs y rate limiters en Next.js (Vector 17)
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Caché agresiva para los archivos estáticos generados por Next.js (Mejora Core Web Vitals)
    location /_next/static/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Caché para los recursos estáticos en la carpeta public
    location /static/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
    }

    # Configuración de logs
    access_log /var/log/nginx/portalempleoit_access.log;
    error_log /var/log/nginx/portalempleoit_error.log;
}
