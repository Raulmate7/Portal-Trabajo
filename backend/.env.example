# --- BASE DE DATOS MYSQL (RAIOLA CPANEL) ---
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="tu_usuario_cpanel_db"
MYSQL_PASSWORD="tu_password_cpanel_db"
MYSQL_DATABASE="tu_nombre_cpanel_db"
MYSQL_SSL="false"

# Cadena de conexión alternativa (usada por scrapers si se prefiere URI)
DATABASE_URL="mysql://tu_usuario_cpanel_db:tu_password_cpanel_db@localhost:3306/tu_nombre_cpanel_db"

# --- PROXY HTTP (DB_PROXY.PHP) ---
# Debe estar habilitado explícitamente en el servidor web (Raiola cPanel)
ENABLE_DB_PROXY="true"
# Token secreto de autenticación (debe coincidir exactamente con DB_PROXY_TOKEN de Vercel)
PROXY_SECRET="genera_un_token_criptografico_seguro_minimo_32_caracteres"
DB_PROXY_TOKEN="genera_un_token_criptografico_seguro_minimo_32_caracteres"
DB_PROXY_URL="https://mail.portalempleoit.com/db_proxy.php"

# --- URL BASE DEL SITIO WEB ---
NEXT_PUBLIC_BASE_URL="https://portalempleoit.com"
FRONTEND_URL="https://portalempleoit.com"

# --- INTELIGENCIA ARTIFICIAL (GEMINI API) ---
# Necesario para generación de noticias diarias, artículos semanales y reportes de mercado
GEMINI_API_KEY="AIzaSy..."

# --- ALERTAS Y NOTIFICACIONES TELEGRAM ---
