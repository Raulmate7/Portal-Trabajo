# Canales temáticos opcionales
TELEGRAM_CHANNEL_FRONTEND=""
TELEGRAM_CHANNEL_BACKEND=""
TELEGRAM_CHANNEL_REMOTO=""
TELEGRAM_CHANNEL_DATA_AI=""
