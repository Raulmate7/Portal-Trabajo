# ==============================================================================
# FRONTEND & EDGE (VERCEL) - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Portal Trabajo IT
# ==============================================================================

# --- BASE Y SEGURIDAD HTTP ---
NEXT_PUBLIC_BASE_URL="https://portalempleoit.com"
NODE_ENV="production"

# --- DATOS IDENTIFICATIVOS LEGALES (LSSI ART. 10 / RGPD ART. 13) ---
NEXT_PUBLIC_LEGAL_OWNER="Raúl Mateo (Portal Trabajo IT)"
NEXT_PUBLIC_LEGAL_NIF="12345678Z"
NEXT_PUBLIC_LEGAL_ADDRESS="Calle Principal 1, 28001 Madrid, España"

# --- PROXY DE BASE DE DATOS (COMUNICACIÓN CON RAIOLA NETWORKS CPANEL) ---
# Usado por Vercel para ejecutar consultas MySQL de forma segura sobre HTTPS
DB_PROXY_URL="https://mail.portalempleoit.com/db_proxy.php"
DB_PROXY_TOKEN="genera_un_token_criptografico_seguro_minimo_32_caracteres"

# (Opcional si se conecta directamente a MySQL en lugar de proxy)
# DATABASE_URL="mysql://usuario:password@ip_host:3306/nombre_bd"
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_USER="usuario"
# MYSQL_PASSWORD="password"
# MYSQL_DATABASE="nombre_bd"
# MYSQL_SSL="false"
# DB_SSL_REJECT_UNAUTHORIZED="true"

# --- MONETIZACIÓN CON STRIPE ---
# Clave secreta de Stripe (formato sk_live_... en producción o sk_test_...)
STRIPE_SECRET_KEY="sk_live_..."
# Clave pública de Stripe para el frontend (formato pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Secreto del webhook de Stripe (obtenido al configurar endpoint /api/webhooks/stripe en Stripe Dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- TOKENS DE SEGURIDAD Y DESCARGA DE INFORMES ---
# Secreto criptográfico dedicado (mínimo 32 caracteres) para firma HMAC de enlaces de descarga
REPORT_TOKEN_SECRET="genera_otro_token_aleatorio_seguro_minimo_32_caracteres"
REPORT_DOWNLOAD_SECRET="genera_otro_token_aleatorio_seguro_minimo_32_caracteres"
MAGIC_LINK_SECRET="genera_un_secreto_para_magic_links_32_caracteres"
UNSUBSCRIBE_SECRET="genera_un_secreto_para_bajas_newsletter_32_caracteres"

# --- NOTIFICACIONES Y CORREOS TRANSACCIONALES (RESEND) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Portal Trabajo IT <alertas@portalempleoit.com>"

# --- NOTIFICACIONES TELEGRAM DE ADMINISTRACIÓN ---
# Token del bot de Telegram (@BotFather) para alertas privadas de publicación y leads
TELEGRAM_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Chat ID numérico privado del administrador (NUNCA el canal público)
TELEGRAM_ADMIN_ID="123456789"

# --- PANEL DE ADMINISTRACIÓN PRIVADO ---
ADMIN_PASSWORD="password_seguro_panel_admin"
ADMIN_SESSION_SECRET="token_sesion_admin_minimo_32_caracteres"

# --- TAREAS AUTOMATIZADAS (CRON) ---
CRON_SECRET="secreto_para_proteger_endpoints_de_cron"

# --- INDEXACIÓN EN BUSCADORES (GOOGLE INDEXING API) ---
GOOGLE_INDEXING_CREDENTIALS='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

